# ==============================================================
# DiBot.Ai - Environment Variables Template
# NEVER commit the actual .env file or real secrets to GitHub!
# ==============================================================

# Server Configuration
PORT=5000
NODE_ENV=production
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas)
MONGODB_URI=your_mongodb_connection_string_here

# AI Service Keys (Provide at least one)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_API_KEY=your_gemini_api_key_here

# Authentication
JWT_SECRET=your_secure_jwt_secret_here

# Frontend Variables (configured on Vercel)
# VITE_API_BASE_URL=https://your-backend-url.onrender.com/api
# VITE_WS_URL=https://your-backend-url.onrender.com
